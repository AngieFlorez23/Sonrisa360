# NO USAR ESTA CLAVE DE EJEMPLO EN PRODUCCIÓN
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=coloca-una-clave-aleatoria-privada-larga-generada-para-tu-servidor
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# SMTP real cuando sea necesario enviar recuperación por correo
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
# SOLO si tienes proxy HTTPS seguro bajo tu control
DJANGO_TRUST_PROXY_HTTPS=0
